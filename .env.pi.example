# Raspberry Pi deployment. Copy to .env.pi; never commit the real file.
POSTGRES_DB=calorie_bridge
POSTGRES_USER=calorie_bridge
POSTGRES_PASSWORD=replace-with-long-random-value
CALORIE_BRIDGE_HOST_PORT=8021

APP_API_KEY=replace-with-your-existing-render-api-key-or-a-new-random-key
DASHBOARD_USERNAME=andy
DASHBOARD_PASSWORD=replace-with-a-long-random-password
APP_TIMEZONE=America/Toronto
DAILY_CALORIE_GOAL=2000
PUBLIC_BASE_URL=https://your-raspberry-pi.your-tailnet.ts.net

FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_TOKEN_SECRET=
FATSECRET_MATCH_MIN_SCORE=0.32
FATSECRET_MAX_SEARCH_RESULTS=12
FATSECRET_DETAIL_CANDIDATES=6
